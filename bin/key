BLOCK_START, BLOCK_END = "<!-- mykeys:start -->", "<!-- mykeys:end -->"
SOURCE_LINE = '[ -f "$HOME/.config/secrets/keys.env" ] && source "$HOME/.config/secrets/keys.env"  # mykeys'
# key scan / key check 默认查看的位置：常见的 shell 配置和 AI 工具配置
