# 以这些结尾的通常是配置（接口地址、地域、编号……），不是秘密
CONFIG_SUFFIXES = ("_BASE_URL", "_API_BASE", "_URL", "_ENDPOINT", "_HOST", "_PORT", "_REGION", "_BUCKET",
                   "_USER", "_USERNAME", "_ORG", "_ORG_ID", "_ORGANIZATION", "_PROJECT", "_PROJECT_ID",
                   "_APP_ID", "_CLIENT_ID", "_MODEL", "_ZONE", "_ACCOUNT_ID")


def category_name(cid):
    zh, en, _ = CATEGORIES[cid]
    return T(zh, en)


def guess(name):
    """按名字猜平台、网址、分类；没猜到返回空字典"""
    best = None
    for prefix, platform, url, cat in CATALOG:
        if name.startswith(prefix) or name == prefix.rstrip("_"):
            if best is None or len(prefix) > len(best[0]):
                best = (prefix, platform, url, cat)
    if not best:
        return {}
    return {"platform": best[1], "url": best[2], "category": best[3]}


def guess_parent(name, entries, lines):
    """配置类名字（如 OPENAI_BASE_URL）找它所属的密钥：同前缀、本身是密钥的条目里前缀最长的那个"""
    if not name.endswith(CONFIG_SUFFIXES):
        return None
    best = None
    for n, e in entries.items():
        if n == name or meta_of(lines, e).get("kind") == "config" or meta_of(lines, e).get("group"):
            continue
        common = os.path.commonprefix([n, name])
        if "_" in common and common.rstrip("_") and (best is None or len(common) > best[0]):
            best = (len(common), n)
    return best[1] if best and best[0] >= 3 else None


def keyword_hit(k, text):
    """中文关键词按子串匹配；英文关键词要出现在词首，免得 ai 命中 Email"""
    text = text.lower()
    return k in text if not k.isascii() else re.search(r"\b" + re.escape(k), text) is not None


def find_section(lines, cid):
    """在文件已有的分类里找和 cid 对得上的那个名字"""
    _, _, kws = CATEGORIES[cid]
    for l in lines:
        m = SECTION_RE.match(l)
        if m and any(keyword_hit(k, m.group(1)) for k in kws):
            return m.group(1)
    return None


