def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        if len(sys.argv) > 2 and sys.argv[2] == "mcp":
            print(HELP_MCP)
            return
        print(T(f"key {VERSION}：API 密钥小工具。密钥文件：{short(KEYS)}", f"key {VERSION}: a small API key manager. Secrets file: {short(KEYS)}"))
        for c, (_, d) in COMMANDS.items():
            print(f"  {c:<12}{d}")
        print(T("\n  key help mcp  怎么给 MCP 服务配密钥", "\n  key help mcp  how to configure keys for MCP servers"))
        return
    if sys.argv[1] in ("--version", "version"):
        print(VERSION)
        return
    c = sys.argv[1]
    if c not in COMMANDS:
        die(T(f"没有 {c} 这个命令，运行 key 看全部命令", f"Unknown command {c}; run key to see all commands"))
    COMMANDS[c][0](sys.argv[2:])


if __name__ == "__main__":
    main()
