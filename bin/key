REPO_URL = "https://github.com/Leoherbertsun/mykeys"


def _config():
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


CONFIG = _config()


def _detect_lang():
    """界面语言：MYKEYS_LANG > config.json 的 lang > macOS 系统首选语言 > LANG。中文以外一律用英文。"""
    v = os.environ.get("MYKEYS_LANG") or CONFIG.get("lang")
    if not v:
        try:
            with open(os.path.join(HOME, "Library", "Preferences", ".GlobalPreferences.plist"), "rb") as fh:
                v = (plistlib.load(fh).get("AppleLanguages") or [""])[0]
        except Exception:
            v = os.environ.get("LC_ALL") or os.environ.get("LANG") or ""
    return "zh" if v.lower().startswith("zh") else "en"


LANG = _detect_lang()


def T(zh, en):
    """按界面语言二选一"""
    return zh if LANG == "zh" else en


def _path_setting(env, key, default):
    v = os.environ.get(env) or CONFIG.get(key) or default
    return os.path.expanduser(v) if v else None


