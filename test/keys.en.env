# Sample secrets file for the app self-check (all values are fake)
# Loaded by ~/.zshenv via source

# ===== AI Models =====
#: platform=DeepSeek url=https://platform.deepseek.com/api_keys account=me@example.com purpose='Chat and web search' tags=daily added=2026-08-01
export DEEPSEEK_API_KEY=sk-fake-deepseek-0000000001
#: kind=config group=DEEPSEEK_API_KEY purpose='OpenAI-compatible base URL'
export DEEPSEEK_BASE_URL='https://api.deepseek.com'
#: platform=OpenAI url=https://platform.openai.com/api-keys purpose='Embeddings' tags=paid
export OPENAI_API_KEY=sk-fake-openai-0000000002
# ===== Data =====
# Relay service: point the SDK at RELAY_URL
#   both primary and backup URLs work
#: platform='Example Relay' expires=2026-12-01 purpose='Market data, full access'
export RELAY_TOKEN='tsr_fake_relay_token_0003'
#: kind=config group=RELAY_TOKEN
export RELAY_URL='http://example.com/sdk'
# ===== Search =====
#: platform=Tavily url=https://app.tavily.com tags=free-tier
export TAVILY_API_KEY=tvly-fake-0000000000004
# ===== Tools & Services =====
#: platform=GitHub url=https://github.com/settings/tokens purpose='CI releases' expires=2026-11-01
export GITHUB_TOKEN=ghp-fake-old-token-00000005
